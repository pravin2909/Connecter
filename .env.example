# ---- Local LLM (LM Studio, OpenAI-compatible) ----
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen2.5-14b-instruct
LLM_API_KEY=lm-studio

# ---- Vision (optional, for browser "computer use") ----
# Set VISION_MODEL to a multimodal model to enable the `look` tool, which lets the agent SEE
# the browser screen and click by coordinates (click_at). The reasoning model above is
# unchanged. Leave VISION_MODEL empty to disable. BASE_URL/API_KEY default to the main LLM's,
# so a vision model loaded in the SAME LM Studio just needs VISION_MODEL set.
# Examples (load one in LM Studio): llava, minicpm-v, llama-3.2-11b-vision.
VISION_MODEL=
VISION_BASE_URL=
VISION_API_KEY=

# ---- Embeddings / RAG ----
# fastembed = run the model in-process (ONNX, CPU). openai = use LM Studio's /v1/embeddings.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25
# Leave empty to disable reranking
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
QDRANT_URL=http://localhost:6333

# ---- Databases ----
DATABASE_URL=postgresql+asyncpg://connecter:connecter@localhost:5433/connecter
# postgres = durable approvals across restarts, memory = dev only
CHECKPOINTER=postgres

# ---- File MCP ----
FILE_WORKSPACE=/Users/pravin/AI-Agent-Workspace

# ---- Email MCP (IMAP/SMTP; for Gmail use an App Password) ----
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_DRAFTS_FOLDER=[Gmail]/Drafts

# ---- Browser MCP ----
# true  = runs in the background (no window); you watch it in the app's side panel. Recommended.
# false = a visible Chromium window opens on your desktop, so you can "Take over" to sign in.
BROWSER_HEADLESS=true

# ---- Agent ----
AGENT_MAX_STEPS=15

# ---- Auth ----
# true  = require email/password login; each user sees only their own data.
# false = single-user local mode (the built-in local user, no login).
AUTH_ENABLED=true
# Set true when serving over HTTPS so the session cookie is sent only over TLS.
SECURE_COOKIES=false
SESSION_TTL_DAYS=30
